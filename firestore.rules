rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = hồ sơ có role == "admin" và status == "approved" (đặt thủ công trong Firebase Console)
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{uid} {
      // Chủ tài khoản đọc hồ sơ của mình; Admin đọc tất cả
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Tự tạo hồ sơ: bắt buộc là giáo viên, đang chờ duyệt (không thể tự phong Admin)
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'teacher'
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid','email','displayName','school','phone','role','status',
              'hasGeminiKey','geminiModel','createdAt','approvedAt']);

      // Giáo viên chỉ được sửa vài trường cá nhân; role/status chỉ Admin được đổi
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName','school','phone','hasGeminiKey','geminiModel']))
        || isAdmin()
      );

      allow delete: if isAdmin();

      // Gemini API Key: chỉ chủ tài khoản đọc/ghi (kể cả Admin cũng không đọc được)
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
